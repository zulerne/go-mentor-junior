# HTTP and environment settings are optional; DATABASE_URL is required.
# Copy to .env for local overrides: cp .env.example .env

# Service environment: local | production
# ENV=local

# HTTP server
# HTTP_ADDRESS=:8080
# HTTP_TIMEOUT=5s
# HTTP_IDLETIMEOUT=60s
# HTTP_SHUTDOWNTIMEOUT=10s

# Required for the service and migration tasks.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable

# Required only for task test-integration; the user must be able to create schemas.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
