# Environment: local or production
ENV=local

# HTTP server address (optional, default: :8080)
HTTP_ADDR=:8080

# HTTP request timeout (optional, default: 5s)
HTTP_TIMEOUT=10s

# HTTP idle timeout (optional, default: 60s)
HTTP_IDLE_TIMEOUT=60s

# HTTP shutdown timeout (optional, default: 10s)
HTTP_SHUTDOWN_TIMEOUT=10s
